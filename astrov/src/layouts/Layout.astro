---
import "../styles/global.css";

interface Props {
  page?: "Home" | "Projects" | "Resources";
  title?: string;
  description?: string;
}
const {
  page = "Home",
  title = "Nilakna Warushavithana",
  description = "Nilakna Warushavithana is an Electronic and Telecommunication Engineering undergraduate interested in analog and mixed-signal circuits, IC design, optoelectronics, sensing, and experimental instrumentation.",
} = Astro.props;
const route = Astro.url.pathname.endsWith(".html")
  ? Astro.url.pathname
  : `${Astro.url.pathname.replace(/\/$/, "")}/`;
const canonical = new URL(route, Astro.site);
const portrait = new URL("/assets/images/chi1.png", Astro.site);
// Add future secondary pages here to include them in the More dropdown.
const moreNavigation = [{ label: "Resources", href: "/resources/" }];
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Nilakna Warushavithana",
  url: Astro.site?.href,
  image: portrait.href,
  sameAs: [
    "https://github.com/NilaknaW",
    "https://linkedin.com/in/nilakna-warushavithana",
    "https://orcid.org/0009-0009-7133-2022",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e0f2f1" />
    <link rel="icon" href="/assets/images/favicon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={portrait} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link
      rel="preload"
      href="/assets/fonts/roboto-slab-400.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="app-bar">
      <a
        class="site-name"
        href="/"
        aria-label="Nilakna Warushavithana — Home"
        aria-current={route === "/" ? "page" : undefined}
      >
        <img
          class="site-icon"
          src="/assets/images/favicon.png"
          width="16"
          height="16"
          alt=""
        />
        <b class="site-name-text">Nilakna Warushavithana</b>
      </a>
      <nav aria-label="Main navigation">
        <a
          class="desktop-nav-link"
          href="/projects/"
          aria-current={page === "Projects" ? "page" : undefined}
        >
          Projects
        </a>
        <!-- <span class="nav-separator" aria-hidden="true"></span> -->
        <a
          class="desktop-nav-link"
          href={route === "/" ? "#contact" : "/#contact"}
        >
          Contact
        </a>
        <!-- <span class="nav-separator" aria-hidden="true"></span> -->
        <details class="nav-more">
          <summary
            aria-label="More"
            class:list={{
              "has-current-page": moreNavigation.some(
                (item) => item.label === page,
              ),
            }}
          >
            <span class="more-text">More</span>
            <svg
              class="more-icon"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M3 5h18v2H3zm0 6h18v2H3zm0 6h18v2H3z" />
            </svg>
          </summary>
          <ul class="nav-dropdown">
            <li class="mobile-nav-item">
              <a
                href="/projects/"
                aria-current={page === "Projects" ? "page" : undefined}
              >
                Projects
              </a>
            </li>
            <li class="mobile-nav-item">
              <a href={route === "/" ? "#contact" : "/#contact"}>Contact</a>
            </li>
            {moreNavigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.label === page ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <script>
      import "../scripts/motion.js";
      import "../scripts/navigation.js";
    </script>
  </body>
</html>
